# Copy to .env.local and fill in. Never commit .env.local.
#
# The site will run without any of these — lib/sanity/queries.ts falls back to
# placeholder books — but the catalog's search needs a real Typesense instance.

# --- Sanity ----------------------------------------------------------------
# Public, not secrets. Safe to share with collaborators.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Typesense -------------------------------------------------------------
# Hostname only, no protocol and no trailing slash.
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https

# SECRET. Must never be prefixed NEXT_PUBLIC_ — that would ship it to the
# browser. Same value as TYPESENSE_API_KEY on the Northflank container, which
# is where the key is actually created (--api-key in docker-entrypoint.sh).
TYPESENSE_API_KEY=

# --- Sanity webhook --------------------------------------------------------
# SECRET. Must match the secret configured on the webhook in manage.sanity.io.
# If these don't match, every webhook call is rejected with a 401 and search
# quietly stops updating in real time.
SANITY_WEBHOOK_SECRET=
